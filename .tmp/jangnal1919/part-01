/* 반 통계: game_results는 anon INSERT only. 집계 엔드포인트(Edge Function/RPC) 확정 전까지 빈 값 유지 → 버튼 미표시 */
const STATS_ENDPOINT = '';
function publicHeaders(extra){
  const key = window.CHARLIE_CONFIG.supabasePublishableKey || '';
  const headers = { apikey: key, ...(extra || {}) };
  if (key.startsWith('eyJ')) headers.Authorization = 'Bearer ' + key;
  return headers;
}
const CLASS = new URLSearchParams(location.search).get('class') || '미입력';
function sendToSupabase(choiceData, comment){
  const { supabaseUrl: url, supabasePublishableKey: key } = window.CHARLIE_CONFIG;
  if (!url || !key || key.startsWith('__')) return Promise.resolve({ ok:false, skipped:true });
  return fetch(url + '/rest/v1/game_results', {
    method: 'POST',
    headers: publicHeaders({ 'Content-Type': 'application/json', Prefer: 'return=minimal' }),
    body: JSON.stringify({
      class: CLASS, game: window.GAME_CONFIG.game_id,
      choices: choiceData, comment: comment || '', timestamp: new Date().toISOString()
    })
  }).then(res => { if (!res.ok) console.warn('[Supabase] 전송 실패 HTTP ' + res.status); return res; })
    .catch(err => { console.warn('[Supabase] 네트워크 전송 실패', err); return { ok:false, failed:true }; });
}

