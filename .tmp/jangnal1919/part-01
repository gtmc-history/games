/* [[용어]] 마커를 DOM으로 변환 — 템플릿 리터럴 안 <span> 삽입 금지 원칙 준수 */
function rich(str){
  const frag = document.createDocumentFragment();
  const parts = str.split(/\[\[(.+?)\]\]/);
  parts.forEach((p, i) => {
    if (i % 2 === 0) { if (p) frag.appendChild(document.createTextNode(p)); }
    else {
      const s = document.createElement('span');
      s.className = 'tt'; s.textContent = p; s.setAttribute('data-term', p); s.setAttribute('tabindex','0');
      frag.appendChild(s);
    }
  });
  return frag;
}
const bubble = document.getElementById('tt-bubble');
function tt(el){
  const term = el.getAttribute('data-term');
  bubble.textContent = TERMS[term] || term;
  bubble.classList.remove('show');
  bubble.style.top = '-9999px'; bubble.style.left = '0';
  const h = bubble.offsetHeight, w = bubble.offsetWidth;
  const r = el.getBoundingClientRect();
  let left = Math.max(8, Math.min(r.left, window.innerWidth - w - 8));
  let top = r.top - h - 8;
  if (top < 8) top = r.bottom + 8;
  bubble.style.left = left + 'px'; bubble.style.top = top + 'px';
  bubble.classList.add('show');
}
document.addEventListener('click', e => {
  const t = e.target.closest('.tt');
  if (t) { e.stopPropagation(); tt(t); } else bubble.classList.remove('show');
});
document.addEventListener('keydown', e => { if (e.key === 'Enter' && e.target.classList && e.target.classList.contains('tt')) tt(e.target); });

