function spaceAxis(p){ if (p.s4_where==='office'||p.s4_where==='myeonjang_home') return 'office'; if (p.s3_when==='marketday'||p.s3_when==='joint'||p.s4_where==='market') return 'market'; return 'village'; }

/* ===== 상태 ===== */
function newSession(){ return (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => { const r = Math.random()*16|0; return (c==='x'?r:(r&3|8)).toString(16); }); }
const S = { step:0, picks:{}, submitted:false, commentSubmitted:false, session: newSession() };
function trace(stage){ return { session_id: S.session, submission_stage: stage }; }
const stage = document.getElementById('stage');
const prog = document.getElementById('prog');
function el(tag, cls, text){ const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.appendChild(rich(text)); return e; }
function clear(){ stage.innerHTML = ''; bubble.classList.remove('show'); window.scrollTo(0,0); }

