  c.appendChild(ul); v.appendChild(c);
  v.appendChild(el('p',null,'모르는 말은 밑줄 친 낱말을 눌러 뜻을 볼 수 있습니다.')).style.color='var(--color-sepia)';
  const row = el('div','btnrow');
