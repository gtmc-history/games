function renderScene(i){
  clear(); const sc = SCENES[i]; prog.textContent = '장면 ' + (i+1) + ' / 5';
  if (sc.intro) {
    const w = el('section','scene intermission');
    w.appendChild(el('div','eyebrow',sc.date));
    w.appendChild(el('h2',null,'길 앞에 면사무소가 있다'));
    sc.intro.forEach(t => w.appendChild(el('p',null,t)));
    const row = el('div','btnrow'); const b = el('button','btn','그 자리에 선다');
    b.onclick = () => renderChoices(i); row.appendChild(b); w.appendChild(row);
    stage.appendChild(w); return;
  }
  renderChoices(i);
}
function renderChoices(i){
  clear(); const sc = SCENES[i]; prog.textContent = '장면 ' + (i+1) + ' / 5';
  const v = el('section','scene');
  v.appendChild(el('div','eyebrow',sc.date));
  v.appendChild(el('h2',null,sc.title));
  if (sc.lead) v.appendChild(el('p','lead',sc.lead));
  v.appendChild(el('p','prompt',sc.prompt));
  const list = el('div','choices'); const btns = [];
  sc.choices.forEach(ch => {
    const b = el('button','choice-card',ch.text); b.type='button';
    b.onclick = () => {
      S.picks[sc.key] = ch.id;
      btns.forEach(x => { x.disabled = true; x.classList.remove('selected'); });
      b.classList.add('selected');
      showResult(v, sc, ch, i);
    };
    btns.push(b); list.appendChild(b);
  });
  v.appendChild(list); stage.appendChild(v);
}

function showResult(v, sc, ch, i){
  const old = v.querySelector('.result'); if (old) old.remove();
  const r = el('div','result');
  const you = el('div','you'); you.appendChild(el('span','lbl','당신의 판단')); you.appendChild(rich((YOU[sc.key]||{})[ch.id] || '')); r.appendChild(you);
  if (ch.cond) {
    const rec = el('div','rec');
    const head = document.createElement('div');
    head.appendChild(el('span','tag','기록'));
    head.appendChild(el('span','grade', ch.grade ? '출처 ' + ch.grade + '등급' : '기록 없음'));
    rec.appendChild(head);
    rec.appendChild(el('p',null,ch.cond));
    r.appendChild(rec);
  }
  if (ch.think) {
    const th = el('div','think');
    th.appendChild(el('span','lbl','생각해 볼 것'));
    th.appendChild(rich(ch.think));
    r.appendChild(th);
  }
  const row = el('div','btnrow');
  const b = el('button','btn',sc.next + ' →');
  b.onclick = () => { if (i < SCENES.length-1) renderScene(i+1); else renderResult(); };
  row.appendChild(b); r.appendChild(row); v.appendChild(r);
  b.scrollIntoView({ behavior:'smooth', block:'nearest' });
}

function trackText(){
  return SCENES.map(sc => { const ch = sc.choices.find(c => c.id === S.picks[sc.key]); return { date:sc.date, title:sc.title, text: ch ? ch.text.replace(/\[\[|\]\]/g,'') : '—' }; });
}
function patternText(){
  const p = S.picks;
  return '관계망: ' + (NET[p.s1_inform]||'—') + ' · 공간: ' + (SPACE[p.s3_when]||'—') + ' → ' + (SPACE[p.s4_where]||'—');
}

function renderResult(){
